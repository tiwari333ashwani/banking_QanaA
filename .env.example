# ==============================================================================
# Daily Q&A Banking Utility Application - Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Daily Q&A Banking Platform"

# Storage Configuration (Local-First; ready to swap to 'gdrive' in cloud phase)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./local_storage

# Google Drive Storage Provider (Configured for Cloud Phase)
GDRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Gmail API Configuration (Official Google APIs v3 for Weekly Reports)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
WEEKLY_REPORT_RECIPIENT_EMAIL=

# Local Mock Email Fallback (true = writes reports to local_storage/reports/weekly/)
MOCK_EMAIL_DISPATCH=true
